# Application data (private — never committed).
# Ignore directory contents but NOT the directories themselves, so the
# protective .htaccess files inside each dir can still be tracked.
/pages/*
!/pages/.htaccess
/config/*
!/config/.htaccess
/cache/*
!/cache/.htaccess
/backups/*
!/backups/.htaccess
/Backups/

# Themes (track default + nozilla CI theme)
/themes/*
!/themes/default/
!/themes/nozilla/

# Extensions
/extensions/*

# Logs
*.log
/purewiki/logs/

# IDE
.vscode/